@model List<BarraGrafica>
@{
    var max = Model.Count == 0 ? 0 : Model.Max(b => b.Cantidad);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="rep-chart">
    @foreach (var b in Model)
    {
        // La barra más alta ocupa el 85 % del espacio; el resto queda para el número
        var altura = (max == 0 ? 0 : b.Cantidad * 85.0 / max).ToString("0.##", inv);
        <div class="rep-col">
            <div class="rep-val">@b.Cantidad</div>
            <div class="rep-bar" style="height:@(altura)%; background:@b.Color"></div>
        </div>
    }
</div>
<div class="rep-labels">
    @foreach (var b in Model)
    {
        <span>@b.Etiqueta</span>
    }
</div>
