@model ErrorViewModel
@{
    var codigo = ViewData["Codigo"] is int c ? c : 500;

    var (titulo, mensaje, icono) = codigo switch
    {
        404 => ("Página no encontrada", "La dirección que buscas no existe o fue movida.", "bi-compass"),
        403 => ("Acceso no permitido", "No tienes permisos para ver esta sección.", "bi-shield-lock"),
        401 => ("Debes iniciar sesión", "Inicia sesión para continuar.", "bi-person-lock"),
        _ => ("Algo salió mal", "Ocurrió un problema inesperado. Intenta nuevamente en unos minutos.", "bi-exclamation-triangle")
    };

    ViewData["Title"] = titulo;
}

<div class="mx-auto text-center py-5" style="max-width: 520px;">
    <div class="display-1 fw-bold text-primary mb-2">@codigo</div>
    <i class="bi @icono text-secondary" style="font-size: 3rem;"></i>
    <h2 class="fw-bold mt-3 mb-2">@titulo</h2>
    <p class="text-muted mb-4">@mensaje</p>

    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-house-door me-1"></i>Ir al inicio
        </a>
        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="history.back()">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </button>
    </div>

    @if (codigo >= 500 && Model?.ShowRequestId == true)
    {
        <p class="small text-muted mt-4 mb-0">Código de soporte: <code>@Model.RequestId</code></p>
    }
</div>
