@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var inicial = email.Length > 0 ? char.ToUpper(email[0]).ToString() : "G";
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var esNegocio = User.IsInRole("Negocio");
    var esAdmin = User.IsInRole("Administrador");
    var esRepartidor = User.IsInRole("Repartidor");
    var rol = esNegocio ? "Negocio" : esAdmin ? "Administrador" : "Repartidor";
    var landing = !autenticado && controlador == "Home" && accion == "Index";

    var enHome = controlador == "Home";
    var enPedido = controlador == "Pedido" && accion == "Registrar";
    var enPedidoActivo = controlador == "Pedido" && accion == "Activos";
    var enHistorial = controlador == "Pedido" && accion == "Historial";
    var enRepartidores = controlador == "Repartidor" && accion != "MisPedidos";
    var enMisPedidos = controlador == "Repartidor" && accion == "MisPedidos";
    var enPerfil = controlador == "Negocio";
    var enNegocios = controlador == "Admin" && accion == "Negocios";
    var enAdmins = controlador == "Admin" && accion != "Negocios" && accion != "Reportes";
    var enReportes = (controlador == "Reporte") || (controlador == "Admin" && accion == "Reportes");
    var enNotificaciones = controlador == "Notificaciones";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gtrack-ui.css" asp-append-version="true" />
</head>
<body>
    @if (autenticado)
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="logo mb-4" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo_Gtrack.png" alt="GTrack" class="logo-img" />
                    <span class="logo-text">GTrack</span>
                </a>

                <nav class="d-flex flex-column gap-1">
                    <a class="side-link @(enHome ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Inicio</a>

                    @if (esNegocio)
                    {
                        <a class="side-link @(enPedido ? "active" : "")" asp-controller="Pedido" asp-action="Registrar"><i class="bi bi-box-seam me-2"></i>Registrar Pedido</a>
                        <a class="side-link @(enPedidoActivo ? "active" : "")" asp-controller="Pedido" asp-action="Activos"><i class="bi bi-list-check me-2"></i>Pedidos Activos</a>
                        <a class="side-link @(enHistorial ? "active" : "")" asp-controller="Pedido" asp-action="Historial"><i class="bi bi-folder2-open me-2"></i>Historial de Pedidos</a>
                        <a class="side-link @(enRepartidores ? "active" : "")" asp-controller="Repartidor" asp-action="Index"><i class="bi bi-people me-2"></i>Repartidores</a>
                        <a class="side-link @(enReportes ? "active" : "")" asp-controller="Reporte" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Reportes</a>
                        @* Nota: "Mi Perfil" se quitó de aquí para que solo aparezca en el menú desplegable inferior *@
                    }
                    @if (esRepartidor)
                    {
                        <a class="side-link @(enMisPedidos ? "active" : "")" asp-controller="Repartidor" asp-action="MisPedidos"><i class="bi bi-box-seam me-2"></i>Mis Pedidos Asignados</a>
                    }
                    @if (esAdmin)
                    {
                        <a class="side-link @(enNegocios ? "active" : "")" asp-controller="Admin" asp-action="Negocios"><i class="bi bi-shop me-2"></i>Negocios</a>
                        <a class="side-link @(enAdmins ? "active" : "")" asp-controller="Admin" asp-action="Administradores"><i class="bi bi-shield-check me-2"></i>Administradores</a>
                        <a class="side-link @(enReportes ? "active" : "")" asp-controller="Admin" asp-action="Reportes"><i class="bi bi-bar-chart-line me-2"></i>Reportes</a>
                    }
                    <a class="side-link @(enNotificaciones ? "active" : "")" asp-controller="Notificaciones" asp-action="Index">🔔 Notificaciones @await Component.InvokeAsync("Notificaciones")</a>

                </nav>

                <div class="dropup mt-auto">
                    <button class="user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@inicial</span>
                        <span class="user-info"><strong>@rol</strong><small>@email</small></span>
                    </button>
                    <ul class="dropdown-menu w-100 shadow">
                        @if (esNegocio)
                        {
                            <li><a class="dropdown-item" asp-controller="Negocio" asp-action="Perfil">Mi perfil</a></li>
                            <li>
                                <form asp-controller="Negocio" asp-action="EnviarCodigo" method="post">
                                    <button type="submit" class="dropdown-item">Editar perfil</button>
                                </form>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }
                        <li>
                            @* CU-28 paso 1: abre el cuadro de confirmación *@
                            <button type="button" class="dropdown-item text-danger"
                                    data-bs-toggle="modal" data-bs-target="#modal-cerrar-sesion">
                                Cerrar sesión
                            </button>
                        </li>
                    </ul>
                </div>
            </aside>

            <main class="app-main" role="main">
                @RenderBody()
            </main>
        </div>

        @* CU-28 paso 2: cuadro de confirmación de cierre de sesión *@
        <div class="modal fade" id="modal-cerrar-sesion" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center p-4">
                        <h5 class="mb-2">¿Estás seguro de que deseas cerrar sesión?</h5>
                        <p id="aviso-cambios" class="text-warning small d-none mb-0">
                            Tienes cambios sin guardar que se perderán.
                        </p>
                    </div>
                    <div class="modal-footer justify-content-center border-0 pb-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <form asp-controller="Usuario" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-danger">Sí, cerrar sesión</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (landing)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <header class="public-bar">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Gtrack.png" alt="GTrack" class="logo-img" />
                <span class="logo-text">GTrack</span>
            </a>
        </header>
        <div class="container py-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    @* Contenedor de notificaciones y confirmación global (ver gtrack-ui.js) *@
    <div id="toast-container" class="toast-stack" aria-live="polite"></div>

    <div class="modal fade" id="modal-confirmacion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-body text-center p-4">
                    <i id="confirmacion-icono" class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <h6 id="confirmacion-titulo" class="fw-bold mb-1">¿Estás seguro?</h6>
                    <p id="confirmacion-mensaje" class="text-muted small mb-4"></p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light border rounded-pill flex-fill" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="confirmacion-ok" class="btn btn-danger rounded-pill flex-fill">Confirmar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/gtrack-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>