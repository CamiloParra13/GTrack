@using Microsoft.AspNetCore.Mvc.Rendering
@model RegistroRepartidorDto
@{
    ViewData["Title"] = "Registrar repartidor";
    var vehiculos = new List<SelectListItem>
    {
        new("Bicicleta", nameof(TipoVehiculo.Bicicleta)),
        new("Moto", nameof(TipoVehiculo.Moto)),
        new("Carro", nameof(TipoVehiculo.Carro)),
        new("A pie", nameof(TipoVehiculo.APie))
    };
    var mostrarPlaca = Model.Vehiculo is TipoVehiculo.Moto or TipoVehiculo.Carro;
}

<div class="mx-auto" style="max-width: 640px;">
    <div class="card shadow-sm p-4">
        <h2>Registrar Nuevo Repartidor</h2>
        <p class="text-muted">Le enviaremos un correo al repartidor para que active su cuenta y cree su propia contraseña.</p>

        <form asp-action="Registrar" method="post" id="form-repartidor">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" placeholder="Ej. Carlos Andrés Gómez" />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Documento" class="form-label"></label>
                    <input asp-for="Documento" class="form-control" inputmode="numeric" placeholder="1012345678" />
                    <span asp-validation-for="Documento" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" type="tel" class="form-control" inputmode="numeric" placeholder="3109876543" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" placeholder="repartidor@correo.com" />
                <div class="form-text"><i class="bi bi-envelope me-1"></i>A este correo le llegará el enlace para activar su cuenta.</div>
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Vehiculo" class="form-label"></label>
                    <select asp-for="Vehiculo" class="form-select" asp-items="vehiculos">
                        <option value="">Selecciona un vehículo</option>
                    </select>
                    <span asp-validation-for="Vehiculo" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3 @(mostrarPlaca ? "" : "d-none")" id="grupo-placa">
                    <label asp-for="Placa" class="form-label"></label>
                    <input asp-for="Placa" class="form-control text-uppercase" maxlength="7" placeholder="ABC123" />
                    <span asp-validation-for="Placa" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">Registrar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const vehiculo = document.getElementById('Vehiculo');
            const grupo = document.getElementById('grupo-placa');
            const placa = document.getElementById('Placa');

            // La placa solo se muestra si el vehículo es Moto o Carro
            function actualizar() {
                const visible = vehiculo.value === 'Moto' || vehiculo.value === 'Carro';
                grupo.classList.toggle('d-none', !visible);
                if (!visible) placa.value = '';
            }
            vehiculo.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}