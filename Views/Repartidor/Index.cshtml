@model List<Repartidor>

@{
    ViewData["Title"] = "Gestión de Repartidores";
    var lista = Model ?? new List<Repartidor>();
    var activos = lista.Count(r => r.Usuario?.Estado == EstadoCuenta.Activo);
    var suspendidos = lista.Count - activos;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Mis Repartidores</h2>
            <p class="text-muted small mb-0">Administra el personal de entrega de tu negocio.</p>
        </div>
        <a asp-action="Registrar" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>Registrar Repartidor
        </a>
    </div>

    @if (TempData["Mensaje"] is string msg)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3">@msg</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3">@err</div>
    }

    @if (lista.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <p class="mb-3">Aún no has registrado repartidores.</p>
                <a asp-action="Registrar" class="btn btn-outline-primary rounded-pill px-4">Registrar el primer repartidor</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="resumen-tile">
                    <div class="resumen-icono bg-primary bg-opacity-10 text-primary"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="resumen-valor">@lista.Count</div>
                        <div class="resumen-texto">Repartidores registrados</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="resumen-tile">
                    <div class="resumen-icono estado-entregado"><i class="bi bi-person-check"></i></div>
                    <div>
                        <div class="resumen-valor">@activos</div>
                        <div class="resumen-texto">Activos</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="resumen-tile">
                    <div class="resumen-icono estado-cancelado"><i class="bi bi-person-x"></i></div>
                    <div>
                        <div class="resumen-valor">@suspendidos</div>
                        <div class="resumen-texto">Suspendidos</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bg-white">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4 py-3">Nombre</th>
                            <th class="py-3">Teléfono</th>
                            <th class="py-3">Correo</th>
                            <th class="py-3">Estado</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rep in lista)
                        {
                            var esActivo = rep.Usuario?.Estado == EstadoCuenta.Activo;
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@rep.NombreCompleto</td>
                                <td>@rep.Telefono</td>
                                <td><span class="text-muted">@(rep.Usuario?.Correo ?? "—")</span></td>
                                <td>
                                    @if (esActivo)
                                    {
                                        <span class="estado-badge estado-entregado"><i class="bi bi-check-circle"></i>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge estado-cancelado"><i class="bi bi-slash-circle"></i>Suspendido</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="CambiarEstado" asp-route-id="@rep.Id" method="post" class="d-inline">
                                        @if (esActivo)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-medium"
                                                    data-confirm="El repartidor @rep.NombreCompleto no podrá recibir ni gestionar pedidos hasta que lo actives de nuevo."
                                                    data-confirm-titulo="¿Suspender repartidor?"
                                                    data-confirm-ok="Sí, suspender"
                                                    data-confirm-tipo="danger">
                                                <i class="bi bi-pause-circle me-1"></i>Suspender
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-medium">
                                                <i class="bi bi-play-circle me-1"></i>Activar
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
