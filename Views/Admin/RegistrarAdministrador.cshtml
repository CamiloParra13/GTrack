@model RegistroAdministradorDto
@{
    ViewData["Title"] = "Registrar administrador";
}

<div class="mx-auto" style="max-width: 560px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h2 class="fw-bold"><i class="bi bi-shield-plus me-2"></i>Registrar Nuevo Administrador</h2>
        <p class="text-muted">Le enviaremos un correo para que active su cuenta y cree su propia contraseña.</p>

        <form asp-action="RegistrarAdministrador" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Ej. María Fernanda Ruiz" />
                </div>
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Documento" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-card-text"></i></span>
                    <input maxlength="10" data-solo-digitos asp-for="Documento" class="form-control" inputmode="numeric" placeholder="1012345678" />
                </div>
                <span asp-validation-for="Documento" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                    <input type="email" maxlength="150" asp-for="Correo" class="form-control" placeholder="admin@correo.com" />
                </div>
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Telefono" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                    <input maxlength="10" data-solo-digitos asp-for="Telefono" type="tel" class="form-control" inputmode="numeric" placeholder="3109876543" />
                </div>
                <span asp-validation-for="Telefono" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Administradores" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check2 me-1"></i>Registrar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
