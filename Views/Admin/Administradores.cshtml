@using System.Globalization
@model List<AdministradorDto>
@{
    ViewData["Title"] = "Administradores";
    var lista = Model ?? new List<AdministradorDto>();

    (string Texto, string Clase, string Icono) Est(EstadoCuenta e) => e switch
    {
        EstadoCuenta.Activo => ("Activo", "estado-entregado", "bi-check-circle"),
        EstadoCuenta.PendienteActivacion => ("Pendiente de activación", "estado-preparacion", "bi-hourglass-split"),
        EstadoCuenta.Suspendido => ("Suspendido", "estado-recibido", "bi-pause-circle"),
        _ => (EstadoPedidoInfo.NombreCuenta(e), "estado-recibido", "bi-dash-circle")
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-shield-check me-2"></i>Administradores</h2>
        <p class="text-muted mb-0">Usuarios con acceso de moderación</p>
    </div>
    <a asp-action="RegistrarAdministrador" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i>Registrar Nuevo Administrador
    </a>
</div>

@if (TempData["Mensaje"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning">@aviso</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (lista.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <p>No hay administradores registrados.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Documento</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Registrado</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in lista)
                    {
                        var est = Est(a.Estado);
                        <tr>
                            <td class="ps-4 fw-semibold">@a.NombreCompleto</td>
                            <td>@a.Documento</td>
                            <td>@a.Correo</td>
                            <td>@a.Telefono</td>
                            @* Fecha guardada en UTC -> hora de Colombia (UTC-5) *@
                            <td>@(a.FechaRegistro?.AddHours(-5).ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("es-CO")) ?? "—")</td>
                            <td>
                                <span class="estado-badge @est.Clase" title="@(a.Estado == EstadoCuenta.PendienteActivacion ? "Le enviamos un correo para que active su cuenta y cree su contraseña" : null)">
                                    <i class="bi @est.Icono"></i>@est.Texto
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                @if (a.Estado == EstadoCuenta.PendienteActivacion)
                                {
                                    @* CU-26: el administrador activa su cuenta desde el correo; aquí solo se puede reenviar *@
                                    <form asp-action="ReenviarActivacion" asp-route-id="@a.UsuarioId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-medium"
                                                data-confirm="Le enviaremos a @a.Correo un nuevo enlace para que active su cuenta y cree su contraseña."
                                                data-confirm-titulo="¿Reenviar correo de activación?"
                                                data-confirm-ok="Sí, reenviar"
                                                data-confirm-tipo="primary">
                                            <i class="bi bi-send me-1"></i>Reenviar correo
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
