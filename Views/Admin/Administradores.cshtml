@using System.Globalization
@model List<AdministradorDto>
@{
    ViewData["Title"] = "Administradores";
    var lista = Model ?? new List<AdministradorDto>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-shield-check me-2"></i>Administradores</h2>
        <p class="text-muted mb-0">Usuarios con acceso de moderación</p>
    </div>
    <a asp-action="RegistrarAdministrador" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i>Registrar Nuevo Administrador
    </a>
</div>

@if (TempData["Mensaje"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning">@aviso</div>
}
@if (TempData["Credenciales"] is string cred)
{
    @* Se queda fija en pantalla (data-no-toast) para que no desaparezca antes de copiar las credenciales *@
    <div class="alert alert-info border-0 shadow-sm rounded-3" data-no-toast>
        <i class="bi bi-key me-1"></i><strong>Credenciales temporales del administrador</strong><br />@cred
    </div>
}

@if (lista.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="empty-state">
            <i class="bi bi-shield-check"></i>
            <p>No hay administradores registrados.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Documento</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Registrado</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in lista)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@a.NombreCompleto</td>
                            <td>@a.Documento</td>
                            <td>@a.Correo</td>
                            <td>@a.Telefono</td>
                            @* Fecha guardada en UTC -> hora de Colombia (UTC-5) *@
                            <td>@(a.FechaRegistro?.AddHours(-5).ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("es-CO")) ?? "—")</td>
                            <td><span class="estado-badge estado-entregado"><i class="bi bi-check-circle"></i>@a.Estado</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
