@model List<NegocioAdminDto>
@{
    ViewData["Title"] = "Negocios";
    (string, string) Est(EstadoCuenta e) => e switch
    {
        EstadoCuenta.Activo => ("Activo", "success"),
        EstadoCuenta.PendienteValidacion => ("Pendiente de validación", "warning"),
        EstadoCuenta.Suspendido => ("Suspendido", "secondary"),
        EstadoCuenta.Rechazado => ("Rechazado", "danger"),
        _ => ("Eliminado", "dark")
    };
}

<h2 class="mb-0">Negocios</h2>
<p class="text-muted">Negocios registrados en la plataforma</p>

@if (TempData["Mensaje"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning">@aviso</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Negocio</th>
                    <th>Actividad</th>
                    <th>NIT / CC</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    var est = Est(n.Estado);
                    <tr>
                        <td class="fw-semibold">@n.Nombre</td>
                        <td>@n.TipoActividad</td>
                        <td>@n.Documento</td>
                        <td>@n.Correo</td>
                        <td>@n.Telefono</td>
                        <td><span class="badge bg-@est.Item2">@est.Item1</span></td>
                        <td class="text-end">
                            @if (n.Estado == EstadoCuenta.PendienteValidacion)
                            {
                                <form asp-action="AprobarNegocio" asp-route-id="@n.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-primary">Aprobar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay negocios registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>