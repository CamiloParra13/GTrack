@model PerfilNegocioDto
@{
    ViewData["Title"] = "Perfil de Negocio";

    var estado = Model.Estado switch
    {
        EstadoCuenta.Activo => ("Activo", "estado-entregado", "bi-check-circle"),
        EstadoCuenta.PendienteValidacion => ("Pendiente de validación", "estado-preparacion", "bi-hourglass-split"),
        EstadoCuenta.Suspendido => ("Suspendido", "estado-recibido", "bi-pause-circle"),
        EstadoCuenta.Rechazado => ("Rechazado", "estado-cancelado", "bi-x-circle"),
        _ => ("Eliminado", "estado-recibido", "bi-trash")
    };
}

<div class="mx-auto" style="max-width: 720px;">

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2 class="mb-0"><i class="bi bi-shop me-2"></i>Perfil de Negocio</h2>
                <p class="text-muted">Información esencial del negocio</p>
            </div>
            <span class="estado-badge @estado.Item2"><i class="bi @estado.Item3"></i>@estado.Item1</span>
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>
            <dt class="col-sm-4">NIT / CC</dt>
            <dd class="col-sm-8">@Model.Documento</dd>
            <dt class="col-sm-4">Actividad económica</dt>
            <dd class="col-sm-8">@Model.TipoActividad</dd>
            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@Model.Direccion</dd>
            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>
            <dt class="col-sm-4">Correo</dt>
            <dd class="col-sm-8">@Model.Correo</dd>
        </dl>

        <form asp-action="EnviarCodigo" method="post">
            <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-pencil-square me-1"></i>Editar perfil</button>
        </form>

        <hr class="mt-4" />
        <p class="mb-0">
            <a href="#" class="text-danger text-decoration-none fw-medium" data-bs-toggle="modal" data-bs-target="#modal-password"><i class="bi bi-trash me-1"></i>Eliminar mi cuenta</a>
        </p>
    </div>
</div>

@* CU-11 paso 2: pide la contraseña actual *@
<div class="modal fade" id="modal-password" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="VerificarEliminacion" method="post" id="form-confirmar">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-shield-lock me-2"></i>Confirma tu identidad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Ingresa tu contraseña actual para continuar con la eliminación de tu cuenta.</p>
                    <div id="error-eliminacion" class="alert alert-danger d-none"></div>
                    <label for="pwd-confirmar" class="form-label">Contraseña</label>
                    <div class="input-group">
                        <input type="password" name="Password" id="pwd-confirmar" class="form-control" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="pwd-confirmar"
                                aria-label="Mostrar u ocultar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger w-100 rounded-pill">Confirmar identidad</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* CU-11 paso 4: confirmación final *@
<div class="modal fade" id="modal-confirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="EliminarCuenta" method="post">
                <input type="hidden" name="Password" id="pwd-final" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>¿Estás seguro de eliminar tu cuenta?</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">No, cancelar</button>
                    <button type="submit" class="btn btn-danger rounded-pill">Sí, eliminar cuenta</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const elPassword = document.getElementById('modal-password');
            const elConfirmar = document.getElementById('modal-confirmar');
            const modalPassword = bootstrap.Modal.getOrCreateInstance(elPassword);
            const modalConfirmar = bootstrap.Modal.getOrCreateInstance(elConfirmar);
            const form = document.getElementById('form-confirmar');
            const campo = document.getElementById('pwd-confirmar');
            const final = document.getElementById('pwd-final');
            const aviso = document.getElementById('error-eliminacion');

            function mostrarError(texto) {
                aviso.textContent = texto;
                aviso.classList.remove('d-none');
            }

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                aviso.classList.add('d-none');
                try {
                    const resp = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    const data = await resp.json();
                    if (data.ok) {
                        final.value = campo.value;
                        elPassword.addEventListener('hidden.bs.modal', function () { modalConfirmar.show(); }, { once: true });
                        modalPassword.hide();
                    } else {
                        mostrarError(data.error);
                    }
                } catch {
                    mostrarError('No fue posible validar tu identidad. Intenta nuevamente');
                }
            });

            // Al cerrar o cancelar, se limpia la contraseña
            elPassword.addEventListener('hidden.bs.modal', function () { campo.value = ''; aviso.classList.add('d-none'); });
            elConfirmar.addEventListener('hidden.bs.modal', function () { final.value = ''; });
        })();
    </script>
}
