@using System.Globalization
@model PerfilPublicoNegocioDto
@{
    ViewData["Title"] = Model.Nombre;
    var miembroDesde = Model.FechaRegistro.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es-CO"));
}

<div class="mx-auto" style="max-width: 480px;">
    <div class="card shadow-sm p-4">
        <p class="text-center text-primary fw-bold small mb-1">GTRACK</p>
        <h2 class="text-center mb-0">@Model.Nombre</h2>
        <p class="text-center text-muted">@Model.TipoActividad</p>

        <dl class="mb-4">
            <dt>Dirección</dt>
            <dd>@Model.Direccion</dd>
            <dt>Teléfono de contacto</dt>
            <dd>@Model.Telefono</dd>
            <dt>En Gtrack desde</dt>
            <dd class="mb-0">@miembroDesde</dd>
        </dl>

        @* CU-25 paso 3: "Volver" regresa a la consulta del pedido (CU-05) *@
        <a href="javascript:history.back()" class="btn btn-outline-primary w-100">Volver</a>
    </div>
</div>
