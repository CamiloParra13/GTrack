@using Microsoft.AspNetCore.Mvc.Rendering
@model RegistroNegocioDto
@{
    ViewData["Title"] = "Registrar negocio";
}

<style>
    .input-validation-error { border-color: #dc3545; }
</style>

<div class="mx-auto" style="max-width: 640px;">
    <div class="card shadow-sm p-4">
        <p class="text-center text-primary fw-bold small mb-1">GTRACK</p>
        <h2 class="text-center">Registra tu Negocio en Gtrack</h2>
        <p class="text-center text-muted">Comienza a gestionar tus pedidos y entregas</p>

        <form asp-action="Registrar" method="post" id="form-registro">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <h6 class="text-uppercase text-muted small mt-2">Información corporativa</h6>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Distribuidora Central SAS" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TipoActividad" class="form-label"></label>
                <select asp-for="TipoActividad" class="form-select"
                        asp-items="@(new SelectList(ActividadesEconomicas.Lista, Model.TipoActividad))">
                    <option value="">Selecciona el sector económico de tu empresa</option>
                </select>
                <span asp-validation-for="TipoActividad" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Documento" class="form-label"></label>
                <input asp-for="Documento" class="form-control" inputmode="numeric" placeholder="901458762" />
                <span asp-validation-for="Documento" class="text-danger small"></span>
            </div>

            <h6 class="text-uppercase text-muted small mt-4">Contacto y localización</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" placeholder="contacto@tuempresa.com" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" type="tel" class="form-control" inputmode="numeric" placeholder="3109876543" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Direccion" class="form-label"></label>
                <input asp-for="Direccion" class="form-control" placeholder="Calle 100 #15-20, Piso 4" />
                <span asp-validation-for="Direccion" class="text-danger small"></span>
            </div>

            <h6 class="text-uppercase text-muted small mt-4">Credenciales de acceso</h6>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label asp-for="Password" class="form-label">Contraseña segura</label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="Password"
                                aria-label="Mostrar u ocultar contraseña">👁</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-2">
                    <label asp-for="ConfirmarPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="ConfirmarPassword"
                                aria-label="Mostrar u ocultar contraseña">👁</button>
                    </div>
                    <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-1">
                <div class="progress" style="height: 6px;">
                    <div id="barra-seguridad" class="progress-bar" role="progressbar" style="width: 0%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted mt-1">
                    <span>Mínimo 6 caracteres, con al menos un número y una letra</span>
                    <span id="texto-seguridad"></span>
                </div>
            </div>

            <button type="submit" id="btn-registrar" class="btn btn-primary w-100 mt-3" disabled>Registrarme</button>
        </form>

        <hr />
        <p class="text-center small mb-1">
            ¿Ya tienes una cuenta? <a asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
        </p>
        <p class="text-center small mb-0"><a asp-controller="Home" asp-action="Index">← Volver al Inicio</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('form-registro');
            const boton = document.getElementById('btn-registrar');
            const pass = document.getElementById('Password');
            const confirmar = document.getElementById('ConfirmarPassword');
            const barra = document.getElementById('barra-seguridad');
            const texto = document.getElementById('texto-seguridad');
            const campos = Array.from(form.querySelectorAll('input:not([type=hidden]), select'));

            function fuerza(p) {
                let puntos = 0;
                if (p.length >= 6) puntos++;
                if (p.length >= 10) puntos++;
                if (/[a-z]/.test(p) && /[A-Z]/.test(p)) puntos++;
                if (/\d/.test(p)) puntos++;
                if (/[^A-Za-z0-9]/.test(p)) puntos++;
                return puntos;
            }

            function actualizarBarra() {
                const p = pass.value;
                const f = p.length === 0 ? 0 : fuerza(p);
                let nivel = { texto: '', clase: 'bg-danger' };
                if (f >= 4) nivel = { texto: 'Fuerte', clase: 'bg-success' };
                else if (f >= 2) nivel = { texto: 'Media', clase: 'bg-warning' };
                else if (f >= 1) nivel = { texto: 'Débil', clase: 'bg-danger' };
                barra.className = 'progress-bar ' + nivel.clase;
                barra.style.width = (f / 5 * 100) + '%';
                texto.textContent = nivel.texto;
            }

            function actualizarBoton() {
                const llenos = campos.every(c => c.value.trim() !== '');
                const documentoOk = /^\d{6,12}$/.test(form.Documento.value.trim());
                const telefonoOk = /^\d{7,10}$/.test(form.Telefono.value.trim());
                const passOk = /^(?=.*\d)(?=.*\p{L}).{6,}$/u.test(pass.value);
                const coinciden = pass.value === confirmar.value;
                boton.disabled = !(llenos && documentoOk && telefonoOk && passOk && coinciden && form.checkValidity());
            }

            form.addEventListener('input', function () { actualizarBarra(); actualizarBoton(); });
            form.addEventListener('change', actualizarBoton);

            document.querySelectorAll('.toggle-password').forEach(function (b) {
                b.addEventListener('click', function () {
                    const campo = document.getElementById(b.dataset.target);
                    campo.type = campo.type === 'password' ? 'text' : 'password';
                });
            });

            actualizarBarra();
            actualizarBoton();
        })();
    </script>
}
