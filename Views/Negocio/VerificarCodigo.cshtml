@model VerificarCodigoDto
@{
    ViewData["Title"] = "Verificar identidad";
}

<div class="mx-auto" style="max-width: 420px;">
    <div class="card shadow-sm p-4">
        <h2 class="text-center">Verifica tu identidad</h2>
        <p class="text-center text-muted">Te enviamos un código de 6 dígitos a tu correo. Ingrésalo para editar tu perfil.</p>

        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-info">@mensaje</div>
        }

        <form asp-action="VerificarCodigo" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control text-center" inputmode="numeric" maxlength="6"
                       autocomplete="one-time-code" placeholder="123456" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Validar Código</button>
        </form>

        <form asp-action="EnviarCodigo" method="post" class="text-center mt-3">
            <button type="submit" class="btn btn-link btn-sm p-0">Reenviar código</button>
        </form>

        <p class="text-center small mt-2 mb-0"><a asp-action="Perfil">Cancelar</a></p>
    </div>
</div>
