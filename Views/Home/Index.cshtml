@{
    ViewData["Title"] = "Inicio";
}

@if (User.Identity?.IsAuthenticated != true)
{
    @* Fondo amigable utilizando una tonalidad suave de Bootstrap (bg-light) con bordes y espacios modernos *@
    <div class="landing d-flex flex-column justify-content-between align-items-center min-vh-75 py-4 px-4 bg-light rounded-4 shadow-sm my-3 mx-auto" style="min-height: 85vh; max-width: 1200px;">

        @if (TempData["Mensaje"] is string msgPublico)
        {
            <div class="alert alert-success w-100 text-center shadow-sm">@msgPublico</div>
        }

        <!-- 1. ARRIBA A LA DERECHA: Botones de Iniciar Sesión y Registrarse -->
        <div class="w-100 d-flex justify-content-end">
            <div class="d-flex gap-2">
                <a asp-controller="Usuario" asp-action="Login" class="btn btn-outline-secondary btn-fondo-blanco rounded-pill px-4 fw-semibold">Iniciar Sesión</a>
                <a asp-controller="Negocio" asp-action="Registrar" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">Registrarse</a>
            </div>
        </div>

        <!-- 2. EN EL CENTRO: Logo y GTrack -->
        <div class="text-center my-auto">
            <a class="logo logo-lg text-decoration-none" asp-controller="Home" asp-action="Index">
                <img src="~/images/Logo_Gtrack.png" alt="GTrack" class="logo-img mb-3" style="max-height: 90px;" />
                <h1 class="display-1 fw-bold text-dark m-0 tracking-tight">GTrack</h1>
            </a>
            <p class="text-muted fs-5 mt-2">Gestiona y consulta el estado de tus pedidos de forma rápida y segura</p>
        </div>

        <!-- 3. ABAJO A LA DERECHA: Botón elegante de consultar pedido (CU-05) -->
        <div class="w-100 d-flex justify-content-end">
            <a asp-controller="Pedido" asp-action="Consultar" class="btn btn-outline-dark btn-fondo-blanco rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2 transition-all">
                <i class="bi bi-search fs-5"></i>
                <span class="fw-medium">Consultar Estado de Pedido</span>
            </a>
        </div>
    </div>
}
else
{
    var esNegocio = User.IsInRole("Negocio");
    var esAdmin = User.IsInRole("Administrador");

    <div class="mx-auto" style="max-width: 900px;">
        @if (TempData["Mensaje"] is string msgPanel)
        {
            <div class="alert alert-success">@msgPanel</div>
        }
        @if (TempData["Error"] is string errPanel)
        {
            <div class="alert alert-danger">@errPanel</div>
        }

        <h2 class="mb-1">Bienvenido a GTrack</h2>
        <p class="text-muted mb-4">Selecciona una opción del menú o entra a una de estas secciones.</p>

        <div class="row g-3">
            @if (esNegocio)
            {
                <div class="col-md-6">
                    <a class="card shadow-sm h-100 p-4 text-decoration-none dash-card border-0" asp-controller="Repartidor" asp-action="Index">
                        <h5><i class="bi bi-people me-2"></i>Repartidores</h5>
                        <p class="text-muted mb-0">Registra y consulta los repartidores de tu negocio.</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="card shadow-sm h-100 p-4 text-decoration-none dash-card border-0" asp-controller="Reporte" asp-action="Index">
                        <h5><i class="bi bi-bar-chart-line me-2"></i>Reportes</h5>
                        <p class="text-muted mb-0">Genera reportes de tus pedidos y descárgalos en Excel o PDF.</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="card shadow-sm h-100 p-4 text-decoration-none dash-card border-0" asp-controller="Negocio" asp-action="Perfil">
                        <h5><i class="bi bi-shop me-2"></i>Mi Perfil</h5>
                        <p class="text-muted mb-0">Consulta, edita o elimina la información de tu negocio.</p>
                    </a>
                </div>
            }
            else if (esAdmin)
            {
                <div class="col-md-6">
                    <a class="card shadow-sm h-100 p-4 text-decoration-none dash-card border-0" asp-controller="Admin" asp-action="Negocios">
                        <h5><i class="bi bi-shop me-2"></i>Negocios</h5>
                        <p class="text-muted mb-0">Revisa y valida los negocios registrados.</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="card shadow-sm h-100 p-4 text-decoration-none dash-card border-0" asp-controller="Admin" asp-action="Reportes">
                        <h5><i class="bi bi-bar-chart-line me-2"></i>Reportes</h5>
                        <p class="text-muted mb-0">Negocios que ingresaron y actividad de pedidos, en Excel o PDF.</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="card shadow-sm h-100 p-4 text-decoration-none dash-card border-0" asp-controller="Admin" asp-action="Administradores">
                        <h5><i class="bi bi-shield-check me-2"></i>Administradores</h5>
                        <p class="text-muted mb-0">Consulta y registra nuevos administradores.</p>
                    </a>
                </div>
            }
            else
            {
                <div class="col-12">
                    <a class="card shadow-sm p-4 text-decoration-none dash-card border-0" asp-controller="Repartidor" asp-action="MisPedidos">
                        <h5><i class="bi bi-box-seam me-2"></i>Mis Pedidos Asignados</h5>
                        <p class="text-muted mb-0">Consulta tus pedidos y actualiza su estado.</p>
                    </a>
                </div>
            }
        </div>
    </div>
}