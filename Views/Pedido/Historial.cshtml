@model IEnumerable<Pedido>

@{
    ViewData["Title"] = "Historial de Pedidos";
    var lista = Model?.ToList() ?? new List<Pedido>();

    // Fechas guardadas en UTC -> hora de Colombia (UTC-5, sin horario de verano)
    string FechaCo(DateTime f) => f.AddHours(-5).ToString("dd/MM/yyyy hh:mm tt", new System.Globalization.CultureInfo("es-CO"));

    var entregados = lista.Count(p => p.EstadoPedidoId == (int)EstadoPedido.Entregado);
    var cancelados = lista.Count(p => p.EstadoPedidoId == (int)EstadoPedido.Cancelado);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h2>Historial de Pedidos</h2>
            <p class="text-muted">Consulta los pedidos que ya han sido entregados o cancelados.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-exportar"><i class="bi bi-download me-1"></i>Exportar</button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (lista.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="empty-state">
                <i class="bi bi-folder2-open"></i>
                <p>No hay registros en el historial de pedidos.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="resumen-tile">
                    <div class="resumen-icono bg-primary bg-opacity-10 text-primary"><i class="bi bi-archive"></i></div>
                    <div>
                        <div class="resumen-valor">@lista.Count</div>
                        <div class="resumen-texto">Pedidos en el historial</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="resumen-tile">
                    <div class="resumen-icono estado-entregado"><i class="bi bi-check2-circle"></i></div>
                    <div>
                        <div class="resumen-valor">@entregados</div>
                        <div class="resumen-texto">Entregados</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="resumen-tile">
                    <div class="resumen-icono estado-cancelado"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <div class="resumen-valor">@cancelados</div>
                        <div class="resumen-texto">Cancelados</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Cliente</th>
                            <th>Dirección</th>
                            <th>Estado final</th>
                            <th>Fecha de creación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in lista)
                        {
                            <tr>
                                <td class="ps-4"><span class="badge bg-light text-dark border font-monospace px-2 py-1">@pedido.Codigo</span></td>
                                <td>@(pedido.Cliente?.NombreCompleto ?? $"Cliente #{pedido.ClienteId}")</td>
                                <td>@pedido.DireccionEntrega</td>
                                <td>
                                    @if (pedido.EstadoPedidoId == (int)EstadoPedido.Entregado)
                                    {
                                        <span class="estado-badge estado-entregado"><i class="bi bi-check2-circle"></i>Entregado</span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge estado-cancelado"><i class="bi bi-x-circle"></i>Cancelado</span>
                                    }
                                </td>
                                <td>@FechaCo(pedido.FechaCreacion)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* CU-22: exportar el historial de pedidos finalizados *@
<div class="modal fade" id="modal-exportar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Reporte" asp-action="ExportarHistorial" method="get" data-sin-aviso>
                <div class="modal-header">
                    <h5 class="modal-title">Exportar historial de pedidos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Se exportan los pedidos entregados o cancelados dentro del rango (máximo 12 meses).</p>
                    <div class="mb-3">
                        <label for="exp-desde" class="form-label">Fecha inicial</label>
                        <input type="date" id="exp-desde" name="desde" class="form-control" required
                               value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="mb-3">
                        <label for="exp-hasta" class="form-label">Fecha final</label>
                        <input type="date" id="exp-hasta" name="hasta" class="form-control" required
                               value="@(DateTime.Today.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="mb-0">
                        <label for="exp-formato" class="form-label">Formato</label>
                        <select id="exp-formato" name="formato" class="form-select">
                            <option value="excel">Excel (.xlsx)</option>
                            <option value="pdf">PDF</option>
                            <option value="csv">CSV</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Descargar</button>
                </div>
            </form>
        </div>
    </div>
</div>
