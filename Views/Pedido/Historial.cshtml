@model IEnumerable<Pedido>

<div class="container mt-4">
    <h2>Historial de Pedidos</h2>
    <p class="text-muted">Consulta los pedidos que ya han sido entregados o cancelados.</p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Cliente</th>
                <th>Dirección</th>
                <th>Estado Final</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var pedido in Model)
                {
                    <tr>
                        <td class="fw-bold">@pedido.Codigo</td>
                        <td>@(pedido.Cliente?.NombreCompleto ?? $"Cliente #{pedido.ClienteId}")</td>
                        <td>@pedido.DireccionEntrega</td>
                        <td>
                            @if (pedido.EstadoPedidoId == (int)EstadoPedido.Entregado)
                            {
                                <span class="badge bg-success">Entregado</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Cancelado</span>
                            }
                        </td>
                        <td>@pedido.FechaCreacion.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No hay registros en el historial de pedidos.</td>
                </tr>
            }
        </tbody>
    </table>
</div>