@model RegistrarPedidoDto
@{
    ViewData["Title"] = "Registrar pedido";
}

<style>
    .input-validation-error {
        border-color: #dc3545;
    }
</style>

<div class="mx-auto" style="max-width: 820px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <p class="text-center text-primary fw-bold small mb-1">GTRACK</p>
        <h2 class="text-center"><i class="bi bi-box-seam me-2"></i>Registrar Nuevo Pedido</h2>
        <p class="text-center text-muted mb-4">Ingresa la información del cliente y los productos solicitados</p>

        <form asp-action="Registrar" method="post" id="form-pedido">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3" role="alert">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <h6 class="text-uppercase text-muted small mt-2"><i class="bi bi-person me-1"></i>Información del cliente</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ClienteTelefono" class="form-label">Teléfono del cliente</label>
                    <input maxlength="10" data-solo-digitos asp-for="ClienteTelefono" type="tel" inputmode="numeric" class="form-control" placeholder="Ej. 3109876543" id="ClienteTelefono" />
                    <span asp-validation-for="ClienteTelefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ClienteNombre" class="form-label">Nombre del cliente</label>
                    <input asp-for="ClienteNombre" class="form-control" placeholder="Ej. Andrea Gómez" id="ClienteNombre" />
                    <span asp-validation-for="ClienteNombre" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DireccionEntrega" class="form-label">Dirección de entrega</label>
                <input asp-for="DireccionEntrega" class="form-control" placeholder="Ej. Calle 12 #4-56 Apto 201" id="DireccionEntrega" />
                <span asp-validation-for="DireccionEntrega" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MetodoPago" class="form-label">Método de pago</label>
                <select asp-for="MetodoPago" class="form-select" asp-items="Html.GetEnumSelectList<MetodoPago>()">
                    <option value="">Selecciona un método de pago</option>
                </select>
                <span asp-validation-for="MetodoPago" class="text-danger small"></span>
            </div>

            <h6 class="text-uppercase text-muted small mt-4"><i class="bi bi-basket me-1"></i>Productos</h6>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Agrega los ítems que conforman este pedido</span>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" id="btn-agregar-producto"><i class="bi bi-plus-lg me-1"></i>Agregar producto</button>
                </div>
                <span asp-validation-for="Productos" class="text-danger small d-block mb-2"></span>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0" id="tabla-productos">
                        <thead class="table-light">
                            <tr>
                                <th>Descripción</th>
                                <th style="width: 120px;">Cantidad</th>
                                <th style="width: 150px;">Precio Unitario ($)</th>
                                <th style="width: 130px;" class="text-end">Subtotal</th>
                                <th style="width: 60px;" class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="productos-tbody">
                            @if (Model.Productos != null && Model.Productos.Any())
                            {
                                for (int i = 0; i < Model.Productos.Count; i++)
                                {
                                    <tr class="fila-producto">
                                        <td>
                                            <input name="Productos[@i].Descripcion" value="@Model.Productos[i].Descripcion" class="form-control item-desc" placeholder="Ej. Hamburguesa doble" required />
                                        </td>
                                        <td>
                                            <input type="number" name="Productos[@i].Cantidad" value="@Model.Productos[i].Cantidad" class="form-control item-cant" min="1" step="1" required />
                                        </td>
                                        <td>
                                            <input type="number" name="Productos[@i].PrecioUnitario" value="@Model.Productos[i].PrecioUnitario.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control item-precio" min="0.01" step="0.01" required />
                                        </td>
                                        <td class="text-end fw-semibold item-subtotal">
                                            $@((Model.Productos[i].Cantidad * Model.Productos[i].PrecioUnitario).ToString("N0", new System.Globalization.CultureInfo("es-CO")))
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-fila" title="Eliminar" aria-label="Eliminar producto"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="fila-producto">
                                    <td>
                                        <input name="Productos[0].Descripcion" class="form-control item-desc" placeholder="Ej. Hamburguesa doble" required />
                                    </td>
                                    <td>
                                        <input type="number" name="Productos[0].Cantidad" value="1" class="form-control item-cant" min="1" step="1" required />
                                    </td>
                                    <td>
                                        <input type="number" name="Productos[0].PrecioUnitario" value="0.00" class="form-control item-precio" min="0.01" step="0.01" required />
                                    </td>
                                    <td class="text-end fw-semibold item-subtotal">
                                        $0
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-fila" title="Eliminar" aria-label="Eliminar producto"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row justify-content-end align-items-center mb-3">
                <div class="col-auto">
                    <label class="form-label fw-bold mb-0">Valor Total:</label>
                </div>
                <div class="col-sm-4">
                    <input type="text" id="valor-total-display" class="form-control form-control-lg fw-bold text-end" value="$0" readonly />
                </div>
            </div>

            <button type="submit" id="btn-guardar-pedido" class="btn btn-primary btn-lg w-100 mt-2 rounded-pill"><i class="bi bi-check2-circle me-1"></i>Guardar Pedido</button>
        </form>

        <hr />
        <p class="text-center small mb-0">
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver al Inicio</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const tbody = document.getElementById('productos-tbody');
            const btnAgregar = document.getElementById('btn-agregar-producto');
            const totalDisplay = document.getElementById('valor-total-display');
            const telInput = document.getElementById('ClienteTelefono');
            const nombreInput = document.getElementById('ClienteNombre');
            const dirInput = document.getElementById('DireccionEntrega');

            function formatoCop(numero) {
                return '$' + numero.toLocaleString('es-CO', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
            }

            function crearFilaHtml(indice) {
                return `
                            <tr class="fila-producto">
                                <td>
                                    <input name="Productos[${indice}].Descripcion" class="form-control item-desc" placeholder="Ej. Hamburguesa doble" required />
                                </td>
                                <td>
                                    <input type="number" name="Productos[${indice}].Cantidad" value="1" class="form-control item-cant" min="1" step="1" required />
                                </td>
                                <td>
                                    <input type="number" name="Productos[${indice}].PrecioUnitario" value="0.00" class="form-control item-precio" min="0.01" step="0.01" required />
                                </td>
                                <td class="text-end fw-semibold item-subtotal">$0</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-eliminar-fila" title="Eliminar" aria-label="Eliminar producto"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        `;
            }

            function actualizarTotalesEIndices() {
                const filas = tbody.querySelectorAll('.fila-producto');
                let total = 0;

                filas.forEach((fila, idx) => {
                    const desc = fila.querySelector('.item-desc');
                    const cant = fila.querySelector('.item-cant');
                    const precio = fila.querySelector('.item-precio');
                    const subtotalEl = fila.querySelector('.item-subtotal');

                    if (desc) desc.name = `Productos[${idx}].Descripcion`;
                    if (cant) cant.name = `Productos[${idx}].Cantidad`;
                    if (precio) precio.name = `Productos[${idx}].PrecioUnitario`;

                    const c = parseFloat(cant?.value || 0);
                    const p = parseFloat(precio?.value || 0);
                    const subtotal = Math.max(0, c * p);

                    total += subtotal;
                    if (subtotalEl) {
                        subtotalEl.textContent = formatoCop(subtotal);
                    }
                });

                if (totalDisplay) {
                    totalDisplay.value = formatoCop(total);
                }
            }

            btnAgregar.addEventListener('click', function () {
                const cantFilas = tbody.querySelectorAll('.fila-producto').length;
                tbody.insertAdjacentHTML('beforeend', crearFilaHtml(cantFilas));
                actualizarTotalesEIndices();
            });

            tbody.addEventListener('click', function (e) {
                const btnEliminar = e.target.closest('.btn-eliminar-fila');
                if (btnEliminar) {
                    const filas = tbody.querySelectorAll('.fila-producto');
                    if (filas.length > 1) {
                        btnEliminar.closest('.fila-producto').remove();
                        actualizarTotalesEIndices();
                    } else {
                        // Si es la única fila, limpiar campos en lugar de eliminarla
                        const fila = filas[0];
                        fila.querySelector('.item-desc').value = '';
                        fila.querySelector('.item-cant').value = '1';
                        fila.querySelector('.item-precio').value = '0.00';
                        actualizarTotalesEIndices();
                    }
                }
            });

            tbody.addEventListener('input', function () {
                actualizarTotalesEIndices();
            });

            // Autocompletar datos de cliente frecuente por teléfono
            if (telInput) {
                telInput.addEventListener('blur', function () {
                    const tel = this.value.trim();
                    if (/^\d{10}$/.test(tel)) {
                        fetch(`/Pedido/BuscarCliente?telefono=${encodeURIComponent(tel)}`)
                            .then(res => res.json())
                            .then(data => {
                                if (data) {
                                    if (nombreInput && !nombreInput.value.trim() && data.nombre) {
                                        nombreInput.value = data.nombre;
                                    }
                                    if (dirInput && !dirInput.value.trim() && data.direccion) {
                                        dirInput.value = data.direccion;
                                    }
                                }
                            })
                            .catch(() => { });
                    }
                });
            }

            actualizarTotalesEIndices();
        })();
    </script>
}