@model Pedido

@{
    ViewData["Title"] = "Consultar Estado de Pedido";

    // Fechas guardadas en UTC -> hora de Colombia (UTC-5, sin horario de verano)
    string FechaCo(DateTime f) => f.AddHours(-5).ToString("dd/MM/yyyy hh:mm tt", new System.Globalization.CultureInfo("es-CO"));

    string Etiqueta(int id) => id switch
    {
        0 => "Recibido",
        1 => "En preparación",
        2 => "Listo para entrega",
        3 => "Asignado",
        4 => "En camino",
        5 => "Entregado",
        6 => "Cancelado",
        _ => "Desconocido"
    };

    string ClaseEstado(int id) => id switch
    {
        0 => "estado-recibido",
        1 => "estado-preparacion",
        2 => "estado-listo",
        3 => "estado-asignado",
        4 => "estado-encamino",
        5 => "estado-entregado",
        6 => "estado-cancelado",
        _ => "estado-recibido"
    };

    var historial = ViewBag.Historial as List<HistorialEstadoItem> ?? new List<HistorialEstadoItem>();
    var cancelado = Model != null && Model.EstadoPedidoId == (int)EstadoPedido.Cancelado;

    // CU-17: solicitud de cancelación del cliente (motivo y fecha), si la hay
    var solicitudCancelacion = ViewBag.Cancelacion as SolicitudCancelacion;
    var puedeCancelar = Model != null && PedidoService.EsCancelablePorCliente(Model.EstadoPedidoId);

    DateTime? fechaCancelacion = historial.Where(h => h.EstadoPedidoId == (int)EstadoPedido.Cancelado)
                                          .OrderByDescending(h => h.FechaCambio)
                                          .Select(h => (DateTime?)h.FechaCambio)
                                          .FirstOrDefault()
                                 ?? solicitudCancelacion?.FechaSolicitud;
}

@if (Model != null && Model.EstadoPedidoId == (int)EstadoPedido.EnCamino)
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="anonymous" />
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+"
      crossorigin="anonymous" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Tarjeta principal de consulta limpia y moderna -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">

                <!-- Encabezado minimalista -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Rastreo de Pedido</h4>
                        <p class="text-muted small mb-0">Ingresa tu código único para verificar el estado de tu orden en tiempo real.</p>
                    </div>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">GTrack</span>
                </div>

                <div class="card-body p-4">

                    <!-- Resumen de errores de validación si los hay -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3 border-0 shadow-sm fs-6 mb-4" role="alert">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <!-- Formulario de búsqueda estilizado con input tipo píldora -->
                    <form asp-action="Consultar" method="post" class="mb-2">
                        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                            <span class="input-group-text bg-white border-0 ps-4 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" name="codigo" class="form-control border-0 py-3 shadow-none" placeholder="Ingresa tu código de pedido" required autocomplete="off" maxlength="8" />
                            <button class="btn btn-dark px-5 fw-semibold" type="submit">Buscar</button>
                        </div>
                    </form>

                    <!-- Resultados de la consulta (si existe el pedido) -->
                    @if (Model != null)
                    {
                        <hr class="my-4 text-muted opacity-25" />

                        @if (ViewBag.MensajeCancelacion is string mensajeCancelacion)
                        {
                            <div class="alert alert-success rounded-3 border-0 shadow-sm mb-4" role="alert">
                                <i class="bi bi-check-circle me-1"></i>@mensajeCancelacion
                            </div>
                        }

                        <div class="d-flex flex-wrap justify-content-between align-items-center bg-light p-3 rounded-3 mb-4">
                            <div>
                                <span class="text-muted small d-block">Pedido Encontrado</span>
                                <h5 class="text-primary fw-bold mb-0">@Model.Codigo</h5>
                            </div>
                            <div class="mt-2 mt-sm-0">
                                <span class="estado-badge @ClaseEstado(Model.EstadoPedidoId) fs-6 px-3 py-2" id="badge-estado-pedido">
                                    @Etiqueta(Model.EstadoPedidoId)
                                </span>
                            </div>
                        </div>

                        @if (Model.EstadoPedidoId == (int)EstadoPedido.EnCamino)
                        {
                            <!-- Sección Tu pedido va en camino con mapa interactivo -->
                            <div class="card border-0 bg-light rounded-4 p-3 mb-4 shadow-sm" id="seccion-pedido-en-camino">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-truck me-1"></i>Tu pedido va en camino</h5>
                                        <small class="text-muted" id="texto-estado-ubicacion">Esperando la ubicación del repartidor…</small>
                                    </div>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold" id="badge-estado-rastreo">
                                        Rastreo en vivo
                                    </span>
                                </div>
                                <div id="mapa-pedido" style="height: 320px; width: 100%; border-radius: 0.75rem;" class="border bg-white shadow-sm"></div>
                            </div>
                        }

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="p-3 border-0 bg-light rounded-3 h-100">
                                    <small class="text-muted d-block mb-1">Negocio</small>
                                    <strong class="text-dark d-block">@(Model.Negocio?.Nombre ?? "No especificado")</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.Negocio?.Telefono))
                                    {
                                        <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i>@Model.Negocio.Telefono</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Negocio?.Usuario?.Correo))
                                    {
                                        <small class="text-muted d-block"><i class="bi bi-envelope me-1"></i>@Model.Negocio.Usuario.Correo</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Negocio?.Direccion))
                                    {
                                        <small class="text-muted d-block"><i class="bi bi-geo-alt me-1"></i>@Model.Negocio.Direccion</small>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border-0 bg-light rounded-3 h-100">
                                    <small class="text-muted d-block mb-1">Fecha de Creación</small>
                                    <strong class="text-dark">@FechaCo(Model.FechaCreacion)</strong>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="p-3 border-0 bg-light rounded-3">
                                    <small class="text-muted d-block mb-1">Dirección de Entrega</small>
                                    <strong class="text-dark">@Model.DireccionEntrega</strong>
                                </div>
                            </div>
                        </div>

                        @if (cancelado)
                        {
                            <div class="alert alert-danger border-0 rounded-3 mb-4">
                                <i class="bi bi-x-circle me-1"></i>Este pedido fue cancelado
                                @if (fechaCancelacion.HasValue)
                                {
                                    <span class="d-block small mt-1">Fecha de cancelación: @FechaCo(fechaCancelacion.Value)</span>
                                }
                                @if (solicitudCancelacion != null)
                                {
                                    <span class="d-block small mt-1">Cancelado por el cliente. Motivo: @solicitudCancelacion.Motivo</span>
                                }
                            </div>
                        }
                        else
                        {
                            <h6 class="fw-bold mb-3 text-dark">Seguimiento del pedido</h6>
                            <ul class="list-unstyled mb-4">
                                @for (var estadoId = 0; estadoId <= 5; estadoId++)
                                {
                                    var alcanzado = estadoId <= Model.EstadoPedidoId;
                                    DateTime? fecha = historial.Where(h => h.EstadoPedidoId == estadoId)
                                                               .OrderBy(h => h.FechaCambio)
                                                               .Select(h => (DateTime?)h.FechaCambio)
                                                               .FirstOrDefault();
                                    if (fecha is null && estadoId == 0) { fecha = Model.FechaCreacion; }

                                    <li class="d-flex align-items-start gap-3 mb-3">
                                        @{
                                            var esActual = estadoId == Model.EstadoPedidoId && estadoId < 5;
                                            var claseIcono = esActual ? "bi-record-circle-fill text-primary timeline-pulse"
                                                           : alcanzado ? "bi-check-circle-fill text-success"
                                                           : "bi-circle text-secondary";
                                        }
                                        <i class="bi @claseIcono fs-5"></i>
                                        <div>
                                            <div class="@(alcanzado ? "fw-semibold text-dark" : "text-muted")">@Etiqueta(estadoId)</div>
                                            @if (alcanzado && fecha.HasValue)
                                            {
                                                <small class="text-muted">@FechaCo(fecha.Value)</small>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }

                        @if (Model.Items != null && Model.Items.Any())
                        {
                            <h6 class="fw-bold mb-3 text-dark">Productos Solicitados</h6>
                            <div class="table-responsive border rounded-3 overflow-hidden shadow-sm">
                                <table class="table table-hover align-middle mb-0 bg-white">
                                    <thead class="table-dark">
                                        <tr>
                                            <th class="py-3 ps-3">Descripción</th>
                                            <th class="py-3 text-center">Cant.</th>
                                            <th class="py-3 text-end">Precio U.</th>
                                            <th class="py-3 text-end pe-3">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="ps-3 py-3">@item.Descripcion</td>
                                                <td class="text-center">@item.Cantidad</td>
                                                <td class="text-end">$@item.PrecioUnitario.ToString("N0", new System.Globalization.CultureInfo("es-CO"))</td>
                                                <td class="text-end fw-bold pe-3">$@((item.Cantidad * item.PrecioUnitario).ToString("N0", new System.Globalization.CultureInfo("es-CO")))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (puedeCancelar)
                        {
                            @* CU-17 paso 2: botón rojo "Cancelar pedido" (solo en estados cancelables) *@
                            <div class="text-center mt-4">
                                <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-semibold"
                                        data-bs-toggle="modal" data-bs-target="#modal-cancelar-pedido">
                                    <i class="bi bi-x-circle me-1"></i>Cancelar pedido
                                </button>
                                <p class="text-muted small mt-2 mb-0">Puedes cancelarlo mientras no haya salido a entrega.</p>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Enlace para volver a la página principal -->
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-medium">
                    <i class="bi bi-arrow-left me-1"></i>Volver a la página principal
                </a>
            </div>

        </div>
    </div>
</div>

@if (puedeCancelar)
{
    @* CU-17 pasos 4 a 7: confirmación "SI/NO" y luego el motivo, en el mismo cuadro *@
    <div class="modal fade" id="modal-cancelar-pedido" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>¿Deseas cancelar este pedido?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div id="cancelar-paso-confirmar">
                    <div class="modal-body">
                        <p class="mb-0">El pedido <strong>@Model?.Codigo</strong> quedará cancelado y el negocio recibirá un aviso. Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        @* FA-18-CU17: "NO" cierra el cuadro sin cambios *@
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">No</button>
                        <button type="button" class="btn btn-danger rounded-pill px-4" id="btn-cancelar-si">Sí</button>
                    </div>
                </div>

                <form asp-action="Cancelar" method="post" id="cancelar-paso-motivo" class="d-none">
                    <input type="hidden" name="codigo" value="@Model?.Codigo" />
                    <div class="modal-body">
                        <label for="motivo-cancelacion" class="form-label fw-semibold">Motivo de la cancelación</label>
                        <textarea name="motivo" id="motivo-cancelacion" class="form-control" rows="3" required
                                  maxlength="@PedidoService.MaxCaracteresMotivo"
                                  placeholder="Ej. Ya no necesito el pedido, me equivoqué en la dirección…"></textarea>
                        <div class="form-text text-end"><span id="motivo-contador">0</span>/@PedidoService.MaxCaracteresMotivo</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Volver</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (puedeCancelar)
    {
        <script>
            (function () {
                const modal = document.getElementById('modal-cancelar-pedido');
                const pasoConfirmar = document.getElementById('cancelar-paso-confirmar');
                const pasoMotivo = document.getElementById('cancelar-paso-motivo');
                const motivo = document.getElementById('motivo-cancelacion');
                const contador = document.getElementById('motivo-contador');

                // Paso 5 -> 6: al confirmar "Sí", el sistema pide el motivo
                document.getElementById('btn-cancelar-si').addEventListener('click', function () {
                    pasoConfirmar.classList.add('d-none');
                    pasoMotivo.classList.remove('d-none');
                    motivo.focus();
                });

                motivo.addEventListener('input', function () { contador.textContent = motivo.value.length; });

                // Al cerrar el cuadro se vuelve a la pregunta inicial sin cambios
                modal.addEventListener('hidden.bs.modal', function () {
                    pasoConfirmar.classList.remove('d-none');
                    pasoMotivo.classList.add('d-none');
                    motivo.value = '';
                    contador.textContent = '0';
                });
            })();
        </script>
    }
    @if (Model != null && Model.EstadoPedidoId == (int)EstadoPedido.EnCamino)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="anonymous"></script>
        <script>
            (function () {
                const codigoPedido = '@Model.Codigo';
                const textoEstadoEl = document.getElementById('texto-estado-ubicacion');
                const badgeRastreoEl = document.getElementById('badge-estado-rastreo');
                const badgeEstadoPedidoEl = document.getElementById('badge-estado-pedido');
                let map = null;
                let marker = null;
                let intervalId = null;

                function inicializarMapa() {
                    // Inicializar mapa centrado en Bogotá por defecto
                    map = L.map('mapa-pedido', {
                        zoomControl: true
                    }).setView([4.6097, -74.0817], 13);

                    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);

                    setTimeout(function () {
                        map.invalidateSize();
                    }, 250);
                }

                async function consultarUbicacion() {
                    try {
                        const res = await fetch('/Pedido/Ubicacion?codigo=' + encodeURIComponent(codigoPedido));
                        if (!res.ok) return;

                        const data = await res.json();

                        // 4. Si el estado deja de ser EnCamino, detén las consultas y muestra el nuevo estado o aviso
                        if (data.estado && data.estado !== "EnCamino") {
                            if (intervalId) {
                                clearInterval(intervalId);
                                intervalId = null;
                            }

                            if (badgeEstadoPedidoEl) {
                                const etiquetas = { Recibido: 'Recibido', EnPreparacion: 'En preparación', ListoParaEntrega: 'Listo para entrega', Asignado: 'Asignado', EnCamino: 'En camino', Entregado: 'Entregado', Cancelado: 'Cancelado' };
                                const clases = { Recibido: 'estado-recibido', EnPreparacion: 'estado-preparacion', ListoParaEntrega: 'estado-listo', Asignado: 'estado-asignado', EnCamino: 'estado-encamino', Entregado: 'estado-entregado', Cancelado: 'estado-cancelado' };
                                badgeEstadoPedidoEl.textContent = etiquetas[data.estado] || data.estado;
                                badgeEstadoPedidoEl.className = 'estado-badge ' + (clases[data.estado] || 'estado-recibido') + ' fs-6 px-3 py-2';
                            }

                            if (data.estado === "Entregado") {
                                if (textoEstadoEl) {
                                    textoEstadoEl.textContent = "¡Tu pedido ha sido entregado exitosamente!";
                                    textoEstadoEl.className = "text-success fw-bold";
                                }
                                if (badgeRastreoEl) {
                                    badgeRastreoEl.className = "badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold";
                                    badgeRastreoEl.textContent = "Entregado";
                                }
                            } else {
                                if (textoEstadoEl) {
                                    textoEstadoEl.textContent = "El estado del pedido ahora es: " + data.estado;
                                    textoEstadoEl.className = "text-muted fw-semibold";
                                }
                                if (badgeRastreoEl) {
                                    badgeRastreoEl.className = "badge bg-secondary px-3 py-2 rounded-pill fw-semibold";
                                    badgeRastreoEl.textContent = data.estado;
                                }
                            }
                            return;
                        }

                        // 3. Colocar o mover marcador, centrar mapa y mostrar hora
                        if (data.disponible && typeof data.lat === 'number' && typeof data.lng === 'number') {
                            const latLng = [data.lat, data.lng];

                            if (!marker) {
                                marker = L.marker(latLng).addTo(map);
                            } else {
                                marker.setLatLng(latLng);
                            }

                            map.setView(latLng, 16);

                            let horaStr = "";
                            if (data.fechaUtc) {
                                const fecha = new Date(data.fechaUtc);
                                horaStr = fecha.toLocaleTimeString('es-CO', { timeZone: 'America/Bogota' });
                            } else {
                                horaStr = new Date().toLocaleTimeString('es-CO', { timeZone: 'America/Bogota' });
                            }

                            if (textoEstadoEl) {
                                textoEstadoEl.textContent = "Última actualización: " + horaStr;
                                textoEstadoEl.className = "text-muted";
                            }
                        } else {
                            if (textoEstadoEl) {
                                textoEstadoEl.textContent = "Esperando la ubicación del repartidor…";
                                textoEstadoEl.className = "text-muted";
                            }
                        }
                    } catch (e) {
                        // Error de red temporal en el polling
                    }
                }

                inicializarMapa();
                consultarUbicacion();
                intervalId = setInterval(consultarUbicacion, 8000);
            })();
        </script>
    }
}