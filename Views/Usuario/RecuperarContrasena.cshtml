@model RecuperarDto
@{ ViewData["Title"] = "Recuperar Contraseña"; }

<div class="mx-auto" style="max-width: 420px;">
    <div class="card shadow-sm p-4">
        <h2 class="text-center">Recuperar Contraseña</h2>
        <p class="text-center text-muted">Ingresa tu dirección de correo electrónico y gestionaremos el restablecimiento.</p>

        <form asp-action="RecuperarContrasena" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" placeholder="ejemplo@correo.com" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Enviar Enlace →</button>
        </form>

        <p class="text-center small mt-3 mb-0"><a asp-action="Login">Iniciar sesión</a></p>
    </div>
</div>