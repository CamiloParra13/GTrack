@model RestablecerDto
@{ ViewData["Title"] = "Restablecer contraseña"; }

<div class="mx-auto" style="max-width: 420px;">
    <div class="card shadow-sm p-4">
        <h2 class="text-center">Restablecer contraseña</h2>
        <p class="text-center text-muted small">Mínimo 6 caracteres, con al menos un número y una letra.</p>

        <form asp-action="RestablecerContrasena" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label asp-for="NuevaPassword" class="form-label">Nueva contraseña</label>
                <input asp-for="NuevaPassword" type="password" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmarPassword" class="form-label">Confirma nueva contraseña</label>
                <input asp-for="ConfirmarPassword" type="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Restablecer contraseña</button>
        </form>
    </div>
</div>