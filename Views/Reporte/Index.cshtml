@model ReporteNegocioVista
@{
    ViewData["Title"] = "Reportes";
    var es = new System.Globalization.CultureInfo("es-CO");
    string Dinero(decimal v) => v.ToString("C0", es);
    var desde = Model.Desde.ToString("yyyy-MM-dd");
    var hasta = Model.Hasta.ToString("yyyy-MM-dd");
}

<div class="mx-auto" style="max-width: 1000px;">
    <h2 class="mb-0"><i class="bi bi-bar-chart-line me-2"></i>Reportes</h2>
    <p class="text-muted">Resumen de los pedidos de tu negocio en un rango de fechas (máximo 12 meses).</p>

    @if (TempData["Error"] is string errorTemp)
    {
        <div class="alert alert-danger">@errorTemp</div>
    }
    @if (Model.Error is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (Model.Aviso is string aviso)
    {
        <div class="alert alert-warning">@aviso</div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <form asp-action="Index" method="get" data-sin-aviso class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="desde" class="form-label">Fecha inicial</label>
                <input type="date" id="desde" name="desde" value="@desde" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label for="hasta" class="form-label">Fecha final</label>
                <input type="date" id="hasta" name="hasta" value="@hasta" class="form-control" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-graph-up me-1"></i>Generar Reporte</button>
            </div>
        </form>
    </div>

    @if (Model.Reporte is { } r)
    {
        var barrasEstado = r.PorEstado.Select(e => new BarraGrafica(e.Estado, e.Cantidad, e.Color)).ToList();

        <div class="alert alert-success">Reporte generado exitosamente</div>

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h5 class="mb-0">@r.NombreNegocio</h5>
                <small class="text-muted">Del @r.Desde.ToString("dd/MM/yyyy") al @r.Hasta.ToString("dd/MM/yyyy")</small>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-success" asp-action="Descargar"
                   asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-formato="excel"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
                <a class="btn btn-outline-danger" asp-action="Descargar"
                   asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-formato="pdf"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                    <small class="text-muted">Total de pedidos</small>
                    <div class="fs-3 fw-semibold">@r.TotalPedidos.ToString("N0", es)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                    <small class="text-muted">Entregados</small>
                    <div class="fs-3 fw-semibold text-success">@r.Entregados.ToString("N0", es)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                    <small class="text-muted">Tasa de entrega</small>
                    <div class="fs-3 fw-semibold">@r.TasaEntrega.ToString("0.0", es) %</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                    <small class="text-muted">Valor entregado</small>
                    <div class="fs-4 fw-semibold">@Dinero(r.ValorEntregado)</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
            <h5>Pedidos por estado</h5>
            <partial name="_GraficaBarras" model="barrasEstado" />
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Estado</th><th class="text-end">Cantidad</th><th class="text-end">Porcentaje</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in r.PorEstado)
                        {
                            <tr>
                                <td><span class="rep-dot" style="background:@e.Color"></span> @e.Estado</td>
                                <td class="text-end">@e.Cantidad.ToString("N0", es)</td>
                                <td class="text-end">@e.Porcentaje.ToString("0.0", es) %</td>
                            </tr>
                        }
                        <tr class="fw-bold table-light">
                            <td>Total</td>
                            <td class="text-end">@r.TotalPedidos.ToString("N0", es)</td>
                            <td class="text-end">100 %</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-body pb-0"><h5 class="mb-0">Pedidos por mes</h5></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mes</th>
                            <th class="text-end">Pedidos</th>
                            <th class="text-end">Entregados</th>
                            <th class="text-end">Cancelados</th>
                            <th class="text-end">Valor entregado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in r.PorMes)
                        {
                            <tr>
                                <td>@m.Mes</td>
                                <td class="text-end">@m.Total.ToString("N0", es)</td>
                                <td class="text-end">@m.Entregados.ToString("N0", es)</td>
                                <td class="text-end">@m.Cancelados.ToString("N0", es)</td>
                                <td class="text-end">@Dinero(m.ValorEntregado)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <p class="text-muted small">
            El reporte agrupa los pedidos por su estado actual y se basa en la fecha de creación del pedido.
            El detalle de cada pedido está disponible en los archivos de Excel y PDF.
        </p>
    }
</div>
