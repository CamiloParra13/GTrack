#line (3,3)-(44,1) "C:\Users\camil\Documentos\5TO SEMESTRE\ING. SOFTWARE\GTrack\Views\Pedido\Activos.cshtml"

    ViewData["Title"] = "Pedidos Activos";
    var lista = Model?.ToList() ?? new List<Pedido>();

    int Contar(params int[] estados) => lista.Count(p => estados.Contains(p.EstadoPedidoId));

    string ClaseEstado(int id) => id switch
    {
        0 => "estado-recibido",
        1 => "estado-preparacion",
        2 => "estado-listo",
        3 => "estado-asignado",
        4 => "estado-encamino",
        5 => "estado-entregado",
        6 => "estado-cancelado",
        _ => "estado-recibido"
    };

    string IconoEstado(int id) => id switch
    {
        0 => "bi-inbox",
        1 => "bi-hourglass-split",
        2 => "bi-box-seam",
        3 => "bi-person-check",
        4 => "bi-truck",
        5 => "bi-check2-circle",
        6 => "bi-x-circle",
        _ => "bi-circle"
    };

    string Etiqueta(int id) => id switch
    {
        0 => "Recibido",
        1 => "En preparación",
        2 => "Listo para entrega",
        3 => "Asignado",
        4 => "En camino",
        5 => "Entregado",
        6 => "Cancelado",
        _ => "Desconocido"
    };

