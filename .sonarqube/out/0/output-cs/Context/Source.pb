    {
        negocio.Usuario = usuario;
        db.Negocios.Add(negocio);
        await db.SaveChangesAsync();
    }

    public async Task ActualizarAsync(Negocio negocio)
    {
        db.Negocios.Update(negocio);
        await db.SaveChangesAsync();
